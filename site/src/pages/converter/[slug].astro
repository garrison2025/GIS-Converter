---
import {routes} from '../../lib/gdal-matrix.mjs';
import {getRouteNote, formats} from '../../data/content.mjs';
import {routeGuides} from '../../data/route-guides.mjs';
export function getStaticPaths(){return routes.map(([slug,from,to])=>({params:{slug},props:{from,to,slug}}));}
const {from,to,slug}=Astro.props;
const info=getRouteNote(slug,from,to);
const guide=routeGuides[slug];
const related=routes.filter(([other,source,target])=>other!==slug&&(source===from||target===to)).slice(0,3);
const label=formats[from].name+' to '+formats[to].name;
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="robots" content="noindex,nofollow"/>
 <meta name="description" content={info.context+' Convert locally with GDAL/WebAssembly; review the result before use.'}/>
 <title>{label} Converter — GIS Converter</title>
 <style>
 :root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#173047;background:#f7fafc;font-synthesis:none}
 *{box-sizing:border-box}body{margin:0;line-height:1.6}a{color:#08796d}
 .container{width:min(1040px,calc(100% - 36px));margin:auto}
 header{background:#fff;border-bottom:1px solid #e0e8ed}
 .nav{min-height:72px;display:flex;justify-content:space-between;align-items:center;gap:16px}
 .logo{color:#173047;text-decoration:none;font-size:19px;font-weight:800;letter-spacing:-.5px;display:flex;align-items:center;gap:10px}
 .symbol{display:grid;place-items:center;width:35px;height:35px;border-radius:11px;background:#0d766c;color:#fff;font-size:22px}
 .navside{font-size:13px;color:#587180}
 .crumb{margin:30px 0 18px;font-size:13px;color:#597688}.crumb a{text-decoration:none}
 .eyebrow{font-size:12px;text-transform:uppercase;font-weight:800;letter-spacing:.12em;color:#057e72}
 h1{font-size:clamp(30px,4vw,44px);line-height:1.19;letter-spacing:-.04em;margin:7px 0 13px}
 .lead{color:#476576;max-width:790px;font-size:17px;margin:0 0 15px}
 .meta{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0 28px}
 .tag{border:1px solid #d7e8e6;background:#fff;border-radius:99px;padding:6px 12px;color:#446578;font-size:12px}
 .grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(250px,1fr);gap:20px;align-items:start}
 .card{background:#fff;border:1px solid #dce7eb;border-radius:16px;padding:24px;box-shadow:0 5px 24px #1348610b}
 .card h2{margin:0 0 7px;font-size:20px;letter-spacing:-.025em}
 .card p{margin:6px 0 14px;color:#506b7b;font-size:14px}
 .uploadzone{border:1.5px dashed #9fc8c0;background:#f5fcfa;padding:18px 20px;border-radius:12px;margin:20px 0 15px}
 .uploadzone label{display:block;font-weight:700;margin-bottom:8px}
 input[type=file]{font:inherit;display:block;width:100%;color:#31546a;max-width:100%;font-size:14px}
 input[type=file]::file-selector-button{font:inherit;background:#fff;border:1px solid #bad0ca;color:#076e63;border-radius:8px;padding:8px 13px;margin-right:12px;font-weight:700;cursor:pointer}
 input[type=file]:focus-visible{outline:3px solid #a5e7d7;outline-offset:4px}
 .small{color:#69808a;font-size:12px!important;margin-top:8px!important}
 .actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
 button,.download{background:#08796d;color:#fff;font:inherit;font-weight:750;font-size:14px;padding:12px 19px;border-radius:10px;border:1px solid #08796d;cursor:pointer;text-decoration:none;display:inline-block}
 button:hover,.download:hover{background:#06665d}
 button:focus-visible,.download:focus-visible{outline:3px solid #c7f3e8;outline-offset:3px}
 button[disabled]{opacity:.6;cursor:wait}
 #cancel{background:#fff;color:#735d43;border-color:#ddcaba}
 #cancel:hover{background:#fff7eb}
 .status{border-top:1px solid #edf1f2;padding-top:14px;margin-top:20px!important;color:#4e6b78;font-size:14px}
 .error{white-space:pre-wrap;background:#fff1f1;color:#982c35!important;padding:10px 12px;border-radius:8px}
 .result{background:#e9f8f2;padding:16px;border-radius:12px;margin-top:15px}
 .result p{margin:0 0 12px;color:#245a4f}
 .quality{background:#fff;border:1px solid #d5e6db;border-radius:11px;margin:16px 0;padding:15px;color:#284456}
 .quality h3{font-size:16px;margin:0 0 6px}.quality p{font-size:13px;color:#3e5f69;margin:0 0 10px}
 .quality ul{margin:0 0 13px;padding-left:20px;font-size:13px}.quality li{margin:5px 0}
 .quality[data-status="review"]{border-color:#e5be8b;background:#fff9ef}
 .quality[data-status="partial"]{border-color:#cfdce1}
 .report-link{font-weight:700;font-size:13px;text-decoration:underline}
 .quality strong{color:inherit}
 #warning{white-space:pre-wrap;color:#7b5c2b;font-size:13px}
 .note{border:1px solid #eeddbb;background:#fff9ef;border-radius:14px;padding:20px;margin-top:20px}
 .note strong{color:#805515}.note p{font-size:13px;color:#725e46;margin:7px 0 0}
 .sidebar .card{margin-bottom:17px}.sidebar ul{padding-left:18px;margin:10px 0 0;color:#506b7b;font-size:14px}
 .sidebar li{margin:7px 0}
 .detail{padding:45px 0}.detail h2{font-size:25px;letter-spacing:-.03em;margin:0 0 15px}
 .details-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
 .details-grid article{background:#fff;border:1px solid #dce7eb;border-radius:14px;padding:20px}
 .details-grid h3{font-size:17px;margin:0 0 8px}.details-grid p{font-size:14px;color:#526d7c;margin:0}
 .steps{padding-left:24px;color:#466777;font-size:15px}.steps li{margin:10px 0;padding-left:4px}
 .route-guide{padding:0 0 44px}.route-guide h2{font-size:25px;line-height:1.3;margin:0 0 14px}.route-guide h3{font-size:17px;margin:0 0 8px}.route-guide p,.route-guide li{font-size:14px;color:#526d7c;line-height:1.72}.route-guide p{margin:0}.guide-layout{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.guide-layout article{background:#fff;border:1px solid #dce7eb;border-radius:13px;padding:20px}.guide-layout .wide{grid-column:span 2}.route-guide .faq{margin-top:28px}.faq-entry{padding:14px 0;border-bottom:1px solid #e2eaed}.faq-entry h3{margin:0 0 6px}.related-tools{margin-top:26px}.related-tools ul{padding-left:18px;margin:8px 0}.related-tools li{margin:6px 0}.related-tools a{font-weight:650;text-decoration:underline;text-underline-offset:3px}@media(max-width:550px){.guide-layout{grid-template-columns:1fr}.guide-layout .wide{grid-column:auto}}
 .footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:15px;padding:30px 0;border-top:1px solid #dfe9eb;color:#637a89;font-size:13px}
 [hidden]{display:none!important}
 @media(max-width:800px){.grid{grid-template-columns:1fr}.sidebar{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.sidebar .card{margin:0}}
 @media(max-width:550px){.sidebar,.details-grid{grid-template-columns:1fr}.card{padding:19px}.navside{display:none}.uploadzone{padding:15px}.detail{padding:32px 0}}
 @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
 </style>
</head>
<body>
<header><div class="container nav">
 <a href="/" class="logo"><span class="symbol" aria-hidden="true">◇</span>GIS Converter</a>
 <span class="navside">Browser-local GIS conversion · Engineering preview</span>
</div></header>
<main class="container">
 <nav class="crumb" aria-label="Breadcrumb"><a href="/">All converters</a> <span aria-hidden="true">›</span> {label}</nav>
 <p class="eyebrow">GDAL / WebAssembly · Local file processing</p>
 <h1>{label} — online file converter</h1>
 <p class="lead">{info.context}</p>
 <div class="meta"><span class="tag">Free test tool</span><span class="tag">15 MiB input limit</span><span class="tag">No file uploads to our servers</span></div>
 <div class="grid">
 <div>
 <form id="converter" class="card" data-slug={slug} aria-label={label+' conversion form'}>
  <h2>Convert your file</h2><p>Select your {info.source.name} file. The converter runs inside an isolated Web Worker in this browser.</p>
  <div class="uploadzone">
   <label for="file">Choose {info.source.name} input file</label>
   <input id="file" name="file" type="file" accept={info.source.accept} required/>
   <p class="small" id="file-info">{info.source.help}</p>
  </div>
  <div class="actions"><button id="submit" type="submit">Convert to {info.target.name} <span aria-hidden="true">→</span></button><button id="cancel" type="button" hidden>Cancel conversion</button></div>
  <p id="status" class="status" role="status" aria-live="polite">Ready to convert.</p>
  <p id="error" class="error" role="alert" hidden></p>
  <section id="result" class="result" aria-label="Conversion result" hidden>
   <strong>Conversion complete</strong>
   <p id="details"></p><p id="warning"></p>
   <section id="quality" class="quality" aria-label="GIS output quality checks" hidden>
     <h3>Automated quality checks</h3>
     <p id="quality-summary"></p>
     <ul id="quality-checks"></ul>
     <a href="#" id="quality-download" class="report-link" download="gis-quality-report.json">Download inspection report (JSON)</a>
     <p class="small">A structural check, not a guarantee of data accuracy. Review geometry, fields and coordinates in independent GIS software.</p>
   </section>
   <a id="download" class="download" href="#" download>Download {info.target.name} <span aria-hidden="true">↓</span></a>
  </section>
 </form>
 <div class="note" role="note"><strong>Important: experimental converter</strong><p>Results are not automatically certified. Verify geometry, attributes and coordinate reference system in your GIS software before using the file for professional or critical decisions.</p></div>
 </div>
 <aside class="sidebar" aria-label="Format requirements">
  <div class="card"><h2>Input requirements</h2><p>{info.source.help}</p>
   <ul><li>File size: maximum 15 MiB</li><li>Unencrypted files only</li><li>Local browser processing</li></ul>
  </div>
  <div class="card"><h2>Output: {info.target.name}</h2><p>{info.target.features}</p><p><strong>Data note:</strong> {info.caution}</p></div>
 </aside>
 </div>
 <section class="detail" aria-label="Conversion instructions">
  <h2>How to convert {info.source.name} to {info.target.name}</h2>
  <ol class="steps">
   <li>Prepare a valid {info.source.long} file. {info.source.help}</li>
   <li>Choose the input above and select <strong>Convert to {info.target.name}</strong>. Conversion happens locally in your browser.</li>
   <li>Download the generated file and open it with compatible GIS software to confirm its coordinates, geometry and fields.</li>
  </ol>
  <div class="details-grid">
   <article><h3>What might change?</h3><p>{info.caution}</p></article>
   <article><h3>How is the file processed?</h3><p>A copy is passed to a dedicated GDAL/WebAssembly worker in your browser. Cancelling terminates the worker. No account is needed for this tool.</p></article>
  </div>
 </section>
 <section class="route-guide" aria-label="Practical format conversion guidance">
  <h2>{info.source.name} to {info.target.name}: practical examples and checks</h2>
  <div class="guide-layout">
   <article class="wide"><h3>Example use case</h3><p>{guide.example}</p></article>
   <article><h3>Prepare the input</h3><p>{guide.inputs}</p></article>
   <article><h3>What the download contains</h3><p>{guide.output}</p></article>
   <article><h3>Verify the converted file</h3><p>{guide.verify}</p></article>
   <article><h3>Common mistake to avoid</h3><p>{guide.mistake}</p></article>
  </div>
  <div class="faq" aria-label="Frequently asked questions">
   <h2>Questions about {info.source.name} to {info.target.name}</h2>
   {guide.faq.map(([question,answer])=><div class="faq-entry">
    <h3>{question}</h3><p>{answer}</p>
   </div>)}
  </div>
  <nav class="related-tools" aria-label="Related converters">
   <h2>Related GIS converters</h2>
   <ul>{related.map(([other,source,target])=><li><a href={'/converter/'+other+'/'}>{formats[source].name} to {formats[target].name} converter</a></li>)}</ul>
  </nav>
 </section>
</main>
<footer class="container footer"><a href="/">← All 19 GIS converters</a><span>Engineering preview · No paid features enabled · Noindex</span></footer>
<script>
import {routes} from '../../lib/gdal-matrix.mjs';
import {runIsolatedConversion} from '../../lib/isolated-task.mjs';
const form=document.querySelector('#converter');
const status=document.querySelector('#status'),btn=document.querySelector('#submit');
const file=document.querySelector('#file'),error=document.querySelector('#error'),result=document.querySelector('#result');
const cancelButton=document.querySelector('#cancel');
const selected=document.querySelector('#file-info');
const placeholder=selected.textContent;
let linkUrl=null,reportUrl=null,activeTask=null;
file.addEventListener('change',()=>{
  if(!file.files?.length){selected.textContent=placeholder;return}
  const f=file.files[0];
  selected.textContent=f.name+' · '+(f.size/1048576).toFixed(2)+' MiB selected (15 MiB maximum)';
});
const resetOutput=()=>{
 if(linkUrl){URL.revokeObjectURL(linkUrl);linkUrl=null;}
 if(reportUrl){URL.revokeObjectURL(reportUrl);reportUrl=null;}
 document.querySelector('#quality').hidden=true;
 result.hidden=true;
 const dl=document.querySelector('#download');dl.removeAttribute('href');
};
cancelButton.addEventListener('click',()=>activeTask?.cancel());
form?.addEventListener('submit',async(event)=>{
 event.preventDefault();
 if(activeTask||!file.files?.[0])return;
 const tuple=routes.find(r=>r[0]===form.dataset.slug);
 if(!tuple){error.hidden=false;error.textContent='Unsupported conversion';return}
 if(file.files[0].size>15*1024*1024){error.hidden=false;error.textContent='The 15 MiB test file limit was exceeded.';return}
 resetOutput();
 btn.disabled=true;file.disabled=true;cancelButton.hidden=false;form.setAttribute('aria-busy','true');
 error.hidden=true;status.textContent='Converting in an isolated Web Worker…';
 let task;
 try{
  task=runIsolatedConversion({file:file.files[0],source:tuple[1],target:tuple[2],timeoutMs:90000});
  activeTask=task;
  const output=await task.promise;
  if(activeTask!==task)return;
  linkUrl=URL.createObjectURL(new Blob([output.bytes],{type:output.mime}));
  const link=document.querySelector('#download');link.href=linkUrl;link.download=output.name;
  document.querySelector('#details').textContent='Generated '+output.name+' ('+(output.bytes.byteLength/1024).toFixed(1)+' KiB).';
  document.querySelector('#warning').textContent=(output.warning?output.warning+' ':'')+'Output has NOT been independently validated.';

  const quality=output.quality;
  if(quality&&Array.isArray(quality.checks)){
    const view=document.querySelector('#quality'),list=document.querySelector('#quality-checks');
    list.replaceChildren();
    const countIn=quality.input?.features,countOut=quality.output?.features;
    const part=(n)=>Number.isInteger(n)?n.toLocaleString():'not fully inspected';
    document.querySelector('#quality-summary').textContent=
      'Input features: '+part(countIn)+' · Output features: '+part(countOut)+
      ' · Review status: '+(quality.status==='review'?'Issues found':quality.status==='checked'?'Checks passed':'Limited inspection');
    for(const check of quality.checks){
      const item=document.createElement('li');
      const label=check.status==='pass'?'✓':check.status==='review'?'⚠':'—';
      item.textContent=label+' '+check.detail;
      list.appendChild(item);
    }
    view.dataset.status=quality.status;
    reportUrl=URL.createObjectURL(new Blob([JSON.stringify(quality,null,2)],{type:'application/json'}));
    const qa=document.querySelector('#quality-download');
    qa.href=reportUrl;qa.download='gis-quality-'+form.dataset.slug+'.json';
    view.hidden=false;
  }

  result.hidden=false;status.textContent='Conversion completed; verify output in GIS software.';
 }catch(e){
  if(task&&activeTask!==task)return;
  if(e?.code==='CANCELLED'){status.textContent='Conversion cancelled. You may retry.'}
  else{error.hidden=false;error.textContent='Conversion failed: '+(e instanceof Error?e.message:String(e));status.textContent=e?.code==='TIMEOUT'?'Timed out. You may retry.':'Failed. You may retry.'}
 }finally{
  if(!task||activeTask===task){
   activeTask=null;btn.disabled=false;file.disabled=false;cancelButton.hidden=true;form.removeAttribute('aria-busy');
  }
 }
});
window.addEventListener('pagehide',()=>{
 activeTask?.cancel();
 if(linkUrl)URL.revokeObjectURL(linkUrl);
 if(reportUrl)URL.revokeObjectURL(reportUrl);
});
</script>
</body>
</html>
