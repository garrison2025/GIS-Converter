---
import {routes} from '../../lib/gdal-matrix.mjs';
export function getStaticPaths(){return routes.map(([slug,from,to])=>({params:{slug},props:{from,to,slug}}));}
const {from,to,slug}=Astro.props;
const formats={shp:'.zip',kmz:'.kmz',kml:'.kml',gpx:'.gpx',geojson:'.json,.geojson',csv:'.csv'};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{from.toUpperCase()} to {to.toUpperCase()} — GIS Converter engineering test</title>

<style>body{font:16px/1.55 system-ui,Arial,sans-serif;background:#f7f9fc;color:#172638;margin:0}.shell{max-width:820px;margin:auto;padding:26px 18px 70px}a{color:#1649ad}nav{display:flex;justify-content:space-between;gap:12px}h1{font-size:clamp(27px,5vw,42px);margin:26px 0 12px}.card{background:#fff;border:1px solid #dce3ea;border-radius:14px;padding:22px;margin:19px 0}.warn{background:#fff4e5;border-color:#eacda0}button,.download{display:inline-block;background:#2159b7;color:white;border:0;border-radius:9px;padding:13px 18px;font:inherit;cursor:pointer;text-decoration:none}button[disabled]{opacity:.6;cursor:wait}#cancel{background:#6a7280;margin-left:8px}input{display:block;width:100%;max-width:500px;margin:12px 0 20px}.status{color:#4a5f78}#error{white-space:pre-wrap;color:#b72c40}#warning{white-space:pre-wrap;color:#7d5215}[hidden]{display:none!important}</style></head>
<body><div class="shell"><nav><a href="/">GIS Converter</a><span>Engineering preview · noindex</span></nav><h1>{from.toUpperCase()} to {to.toUpperCase()}</h1>
<p>Convert locally using GDAL WebAssembly. Files are processed in your browser. No files are uploaded by this test interface.</p>
<div class="card warn"><strong>Experimental</strong><p>Only small files and limited test inputs have been verified. Geometry, projections and attributes may be lost or altered. Do not use outputs for professional or safety-critical datasets.</p></div>
<form id="converter" class="card" data-slug={slug}>
<label for="file"><strong>Choose input file</strong> ({formats[from]})</label>
<input id="file" name="file" type="file" accept={formats[from]} required />
<button id="submit" type="submit">Convert file</button><button id="cancel" type="button" hidden>Cancel conversion</button><p id="status" class="status" role="status" aria-live="polite">Ready.</p>
<p id="error" role="alert" hidden></p>
<section id="result" hidden><p id="details"></p><p id="warning"></p><a id="download" class="download" href="#" download>Download conversion</a></section>
</form><p><a href="/">All 19 test conversion routes</a></p></div>
<script>
import {routes} from '../../lib/gdal-matrix.mjs';
import {runIsolatedConversion} from '../../lib/isolated-task.mjs';
const form=document.querySelector('#converter');
const status=document.querySelector('#status'),btn=document.querySelector('#submit');
const file=document.querySelector('#file'),error=document.querySelector('#error'),result=document.querySelector('#result');
const cancelButton=document.querySelector('#cancel');
let linkUrl=null,activeTask=null;
const resetOutput=()=>{
 if(linkUrl){URL.revokeObjectURL(linkUrl);linkUrl=null;}
 result.hidden=true;
 const dl=document.querySelector('#download');dl.removeAttribute('href');
};
cancelButton.addEventListener('click',()=>activeTask?.cancel());
form?.addEventListener('submit',async(event)=>{
 event.preventDefault();
 if(activeTask||!file.files?.[0])return;
 const tuple=routes.find(r=>r[0]===form.dataset.slug);
 if(!tuple){error.hidden=false;error.textContent='Unsupported conversion';return}
 if(file.files[0].size>15*1024*1024){error.hidden=false;error.textContent='The 15 MiB test file limit was exceeded.';return}
 resetOutput();
 btn.disabled=true;file.disabled=true;cancelButton.hidden=false;
 error.hidden=true;status.textContent='Converting in an isolated Web Worker…';
 let task;
 try{
  task=runIsolatedConversion({file:file.files[0],source:tuple[1],target:tuple[2],timeoutMs:90000});
  activeTask=task;
  const output=await task.promise;
  if(activeTask!==task)return;
  linkUrl=URL.createObjectURL(new Blob([output.bytes],{type:output.mime}));
  const link=document.querySelector('#download');link.href=linkUrl;link.download=output.name;
  document.querySelector('#details').textContent='Generated '+output.name+' ('+(output.bytes.byteLength/1024).toFixed(1)+' KiB).';
  document.querySelector('#warning').textContent=(output.warning?output.warning+' ':'')+'Output has NOT been independently validated.';
  result.hidden=false;status.textContent='Conversion completed; verify output in GIS software.';
 }catch(e){
  if(task&&activeTask!==task)return;
  if(e?.code==='CANCELLED'){status.textContent='Conversion cancelled. You may retry.'}
  else{error.hidden=false;error.textContent='Conversion failed: '+(e instanceof Error?e.message:String(e));status.textContent=e?.code==='TIMEOUT'?'Timed out. You may retry.':'Failed. You may retry.'}
 }finally{
  if(!task||activeTask===task){
   activeTask=null;btn.disabled=false;file.disabled=false;cancelButton.hidden=true;
  }
 }
});
window.addEventListener('pagehide',()=>{
 activeTask?.cancel();
 if(linkUrl)URL.revokeObjectURL(linkUrl);
});

</script>
</body></html>