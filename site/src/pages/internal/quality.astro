---
const title='GDAL quality gate — polygon rings, Unicode and CRS reprojection';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="robots" content="noindex,nofollow"/><title>{title}</title><script is:inline src="/engine/gdal3/gdal3.js"></script></head><body><h1>{title}</h1><pre id="results">NOT_STARTED</pre>
<script>
import {convertGdal,makeFixture} from '../../lib/gdal-matrix.mjs';
import {createGISQualityReport,assertNoDetectedCriticalDataLoss} from '../../lib/quality-report.mjs';
import JSZip from 'jszip';
const report={status:'RUNNING',cases:[],errors:[]};
window.__qualityResult=report;
const render=()=>document.querySelector('#results').textContent=JSON.stringify(report,null,2);
function assert(cond,label){if(!cond)throw new Error('Assertion failed: '+label)}
const ringArea=ring=>Math.abs(ring.reduce((s,p,i)=>{const q=ring[(i+1)%ring.length];return s+(p[0]*q[1]-q[0]*p[1]);},0))/2;
function geometryMetrics(geometry){
 const polygons=geometry.type==='Polygon'?[geometry.coordinates]:geometry.type==='MultiPolygon'?geometry.coordinates:[];
 return {polygons:polygons.length,holes:polygons.reduce((s,rings)=>s+rings.length-1,0),area:polygons.reduce((s,rings)=>s+ringArea(rings[0])-rings.slice(1).reduce((a,r)=>a+ringArea(r),0),0)};
}
async function mark(label,fn){try{const data=await fn();report.cases.push({name:label,status:'PASSED',...data})}catch(e){report.cases.push({name:label,status:'FAILED',error:String(e instanceof Error?e.stack:JSON.stringify(e))})}render();}
(async()=>{
 try{
 const gdal=await window.initGdalJs({path:'/engine/gdal3',useWorker:false});
 await mark('polygon holes and multipolygon with UTF-8 labels',async()=>{
  const geojson={type:'FeatureCollection',features:[
   {type:'Feature',properties:{Label:'北京公园',Count:2},geometry:{type:'Polygon',coordinates:[
    [[0,0],[4,0],[4,4],[0,4],[0,0]],
    [[1,1],[1,2],[2,2],[2,1],[1,1]]
   ]}},
   {type:'Feature',properties:{Label:'岛屿群',Count:3},geometry:{type:'MultiPolygon',coordinates:[
    [[[10,10],[12,10],[12,12],[10,12],[10,10]]],
    [[[15,10],[16,10],[16,11],[15,11],[15,10]]]
   ]}}
  ]};
  const file=new File([JSON.stringify(geojson)],'polygons.geojson',{type:'application/geo+json'});
  const exported=await convertGdal(gdal,file,'geojson','shp');
  const zip=await JSZip.loadAsync(exported.bytes);
  const names=Object.keys(zip.files);
  assert(names.some(n=>n.toLowerCase().endsWith('.cpg')),'UTF8 .cpg included');
  const cpgName=names.find(n=>n.toLowerCase().endsWith('.cpg'));
  const cpg=await zip.file(cpgName).async('string');
  assert(cpg.toUpperCase().includes('UTF-8'),'shapefile UTF8 encoding marker');
  const imported=await convertGdal(gdal,new File([exported.bytes],'from-geojson.zip'),'shp','geojson');
  const out=JSON.parse(new TextDecoder().decode(imported.bytes));
  assert(out.type==='FeatureCollection'&&out.features?.length===2,'preserve two features');
  const labels=out.features.map(f=>f.properties?.Label).sort();
  assert(labels.includes('北京公园')&&labels.includes('岛屿群'),'Chinese labels roundtrip');
  const counts=out.features.map(f=>f.properties?.Count).sort((a,b)=>a-b);
  assert(JSON.stringify(counts)==='[2,3]','integer attribute values preserved');
  const metrics=out.features.map(f=>geometryMetrics(f.geometry));
  const polygons=metrics.reduce((s,f)=>s+f.polygons,0),holes=metrics.reduce((s,f)=>s+f.holes,0),area=metrics.reduce((s,f)=>s+f.area,0);
  assert(polygons===3,'three polygon parts preserved');
  assert(holes===1,'one polygon hole preserved');
  assert(Math.abs(area-20)<.001,'planar area preserved, 20 square-degrees in test');
  return {features:out.features.length,polygons,holes,area,labels,cpg};
 });
 await mark('EPSG:3857 SHP with reprojection back to WGS84',async()=>{
   const input=await makeFixture('geojson');
   const opened=await gdal.open(input);
   const ds=opened.datasets?.[0];assert(ds,'open GeoJSON point');
   const packed=new JSZip();
   try{
     const exported=await gdal.ogr2ogr(ds,['-f','ESRI Shapefile','-t_srs','EPSG:3857','-lco','ENCODING=UTF-8'],'test_3857');
     const files=Array.isArray(exported?.all)?exported.all:[exported];
     for(const file of files){
       const name=String(file?.local||file).split('/').pop();
       const b=await gdal.getFileBytes(file);
       if(b?.length)packed.file(name,b);
     }
   } finally{try{gdal.close(ds)}catch{}}
   const names=Object.keys(packed.files);
   assert(names.some(n=>n.endsWith('.prj')),'projected shapefile .prj exists');
   const bytes=new Uint8Array(await packed.generateAsync({type:'uint8array'}));
   const result=await convertGdal(gdal,new File([bytes],'projected.zip'),'shp','geojson');
   const geo=JSON.parse(new TextDecoder().decode(result.bytes));
   const point=geo.features?.[0]?.geometry;
   assert(point?.type==='Point','point geometry');
   assert(Math.abs(point.coordinates[0]-116.4)<.0001&&Math.abs(point.coordinates[1]-39.9)<.0001,'3857 to 4326 coordinate accuracy');
   return {sourceProjection:'EPSG:3857',targetProjection:'EPSG:4326',coordinates:point.coordinates,files:names};
 });

 await mark('3857 projected polygon with an inner ring to WGS84',async()=>{
  const input={type:'FeatureCollection',features:[{type:'Feature',properties:{Code:'A-100',Population:2094},
    geometry:{type:'Polygon',coordinates:[[
      [116.3,39.8],[116.5,39.8],[116.5,40],[116.3,40],[116.3,39.8]
    ],[
      [116.35,39.85],[116.35,39.9],[116.4,39.9],[116.4,39.85],[116.35,39.85]
    ]]}}]};
  const inputFile=new File([JSON.stringify(input)],'source-polygon.geojson');
  const o=await gdal.open(inputFile);
  const ds=o.datasets?.[0];assert(ds,'open source polygon');
  const pack=new JSZip();
  try{
    const generated=await gdal.ogr2ogr(ds,['-f','ESRI Shapefile','-t_srs','EPSG:3857','-lco','ENCODING=UTF-8'],'projected-polygon');
    const all=Array.isArray(generated?.all)?generated.all:[generated];
    for(const ref of all){
      const name=String(ref?.local||ref).split('/').pop();
      const bytes=await gdal.getFileBytes(ref);
      if(bytes?.length)pack.file(name,bytes);
    }
  }finally{try{gdal.close(ds)}catch{}}
  assert(Object.keys(pack.files).some(x=>x.endsWith('.prj')),'projected polygon CRS .prj exists');
  const projected=new File([await pack.generateAsync({type:'uint8array'})],'proj-polygon.zip');
  const processed=await convertGdal(gdal,projected,'shp','geojson');
  const data=JSON.parse(new TextDecoder().decode(processed.bytes));
  assert(data.features?.length===1,'polygon feature retained');
  const feature=data.features[0];
  assert(feature.properties.Code==='A-100'&&feature.properties.Population===2094,'text + numeric fields retained');
  const geometry=feature.geometry;assert(geometry.type==='Polygon','polygon geometry retained');
  assert(geometry.coordinates.length===2,'inner hole retained');
  const expected=geometryMetrics(input.features[0].geometry);
  const got=geometryMetrics(geometry);
  assert(expected.holes===got.holes,'hole count retained');
  assert(Math.abs(got.area-expected.area)<.000015,'polygon projected roundtrip area accuracy');
  const bounds=(coords)=>{
    const flat=coords.flatMap(x=>Array.isArray(x[0])?x:[x]).flatMap(x=>Array.isArray(x[0])?x:[x]);
    return [Math.min(...flat.map(p=>p[0])),Math.min(...flat.map(p=>p[1])),Math.max(...flat.map(p=>p[0])),Math.max(...flat.map(p=>p[1]))]
  };
  const expectedBox=bounds(input.features[0].geometry.coordinates);
  const actualBox=bounds(geometry.coordinates);
  assert(expectedBox.every((v,i)=>Math.abs(v-actualBox[i])<.0001),'roundtripped polygon bounds in WGS84');
  return {features:1,holes:got.holes,area:got.area,properties:feature.properties.Code+' / '+feature.properties.Population,bounds:actualBox};
 });
 await mark('mixed point/polygon SHP conversion must not silently omit data',async()=>{
   const input={type:'FeatureCollection',features:[
     {type:'Feature',properties:{Label:'First'},geometry:{type:'Point',coordinates:[116.4,39.9]}},
     {type:'Feature',properties:{Label:'Second'},geometry:{type:'Polygon',coordinates:[[[116,39],[117,39],[117,40],[116,39]]]}}
   ]};
   let converted=null;let reportedError=null;
   try{converted=await convertGdal(gdal,new File([JSON.stringify(input)],'mixed.geojson'),'geojson','shp')}
   catch(e){reportedError=String(e?.message||e)}
   if(reportedError)return {outcome:'rejected',error:reportedError.slice(0,240)};
   const result=await convertGdal(gdal,new File([converted.bytes],'mixed.zip'),'shp','geojson');
   const parsed=JSON.parse(new TextDecoder().decode(result.bytes));
   assert(parsed.features?.length===2,'mixed geometry conversion silently dropped features');
   return {outcome:'preserved',features:parsed.features.length};
 });


 await mark('GPX waypoint and track layers must be present in KML export',async()=>{
   const xml='<?xml version="1.0" encoding="UTF-8"?><gpx version="1.1" creator="GIS-QA" xmlns="http://www.topografix.com/GPX/1/1"><wpt lat="39.9" lon="116.4"><name>QA Waypoint</name></wpt><trk><name>QA Track</name><trkseg><trkpt lat="39.8" lon="116.3"/><trkpt lat="39.85" lon="116.35"/></trkseg></trk></gpx>';
   const file=new File([xml],'multi-layer.gpx');
   let output;
   try{output=await convertGdal(gdal,file,'gpx','kml')}
   catch(e){return {outcome:'conversion-refused',reason:String(e?.message||e)}}
   const kml=new TextDecoder().decode(output.bytes);
   assert(kml.includes('QA Waypoint'),'GPX waypoint silently omitted');
   assert(kml.includes('QA Track'),'GPX track silently omitted');
   assert(/<LineString>/.test(kml),'GPX track did not become a line');
   return {outcome:'preserved',hasWaypoint:true,hasTrack:true,size:output.bytes.length};
 });


 // P20: A GPX dataset also exposes auxiliary route_points/track_points GDAL
 // layers. Those are NOT independent user features in KML or KMZ.
 const gpxP20='<?xml version="1.0" encoding="UTF-8"?>'+
  '<gpx version="1.1" creator="P20 GIS QA" xmlns="http://www.topografix.com/GPX/1/1">'+
  '<wpt lat="39.90" lon="116.40"><name>P20 Waypoint A</name></wpt>'+
  '<wpt lat="39.91" lon="116.41"><name>P20 Waypoint B</name></wpt>'+
  '<rte><name>P20 Route A</name><rtept lat="39.8" lon="116.3"/><rtept lat="39.82" lon="116.32"/></rte>'+
  '<rte><name>P20 Route B</name><rtept lat="39.7" lon="116.2"/><rtept lat="39.72" lon="116.22"/></rte>'+
  '<trk><name>P20 Track A</name><trkseg><trkpt lat="39.6" lon="116.1"/><trkpt lat="39.62" lon="116.12"/></trkseg>'+
  '<trkseg><trkpt lat="39.64" lon="116.14"/><trkpt lat="39.66" lon="116.16"/></trkseg></trk>'+
  '<trk><name>P20 Track B</name><trkseg><trkpt lat="39.5" lon="116.0"/><trkpt lat="39.52" lon="116.02"/></trkseg></trk></gpx>';
 async function verifyP20Gpx(dst){
   const file=new File([gpxP20],'p20-multiple-features.gpx');
   const output=await convertGdal(gdal,file,'gpx',dst);
   let kml=dst==='kml'?new TextDecoder().decode(output.bytes):'';
   if(dst==='kmz'){
     const archive=await JSZip.loadAsync(output.bytes);
     assert(Object.keys(archive.files).filter(x=>x.toLowerCase().endsWith('.kml')).length===1,'KMZ contains one KML file');
     kml=await archive.file('doc.kml').async('string');
   }
   const placemarks=[...kml.matchAll(/<Placemark\b/gi)];
   assert(placemarks.length===6,'GPX 2 waypoints + 2 routes + 2 tracks must become exactly six KML Placemarks, got '+placemarks.length);
   for(const name of ['P20 Waypoint A','P20 Waypoint B','P20 Route A','P20 Route B','P20 Track A','P20 Track B']){
     assert(kml.includes(name),'GPX feature omitted: '+name);
   }
   assert([...kml.matchAll(/<Point\b/gi)].length===2,'Route/track vertices duplicated as standalone KML points');
   const lineStrings=[...kml.matchAll(/<LineString\b[^>]*>[\s\S]*?<coordinates\b[^>]*>([\s\S]*?)<\/coordinates>/gi)];
   // Two routes + two segments of Track A + one segment of Track B.
   assert(lineStrings.length===5,'GPX track segment structure changed: expected five lines, got '+lineStrings.length);
   const vertices=lineStrings.flatMap(match=>match[1].trim().split(/\s+/).map(pair=>pair.split(',').slice(0,2).map(Number)));
   assert(vertices.length===10,'GPX route/track vertices changed: expected 10, got '+vertices.length);
   const expectedVertices=[[116.3,39.8],[116.32,39.82],[116.2,39.7],[116.22,39.72],
     [116.1,39.6],[116.12,39.62],[116.14,39.64],[116.16,39.66],[116.0,39.5],[116.02,39.52]];
   for(const [lon,lat] of expectedVertices){
     assert(vertices.some(p=>Math.abs(p[0]-lon)<1e-6&&Math.abs(p[1]-lat)<1e-6),
       'GPX route/track vertex dropped or moved: '+lon+','+lat);
   }
   const q=await createGISQualityReport(file,'gpx',output.bytes,dst);
   const check=q.checks.find(x=>x.id==='gpx-logical-features');
   assert(check?.status==='pass','Independent GPX logical feature check failed '+JSON.stringify(check));
   assertNoDetectedCriticalDataLoss(q);
   return {sourceLogicalFeatures:6,exportPlacemarks:placemarks.length,lineGeometries:lineStrings.length,routeAndTrackVertices:vertices.length,qualityStatus:check.status,outputBytes:output.bytes.length};
 }
 await mark('P20 mixed GPX waypoints routes and multi-segment tracks to KML without auxiliary duplicate features',()=>verifyP20Gpx('kml'));
 await mark('P20 mixed GPX waypoints routes and multi-segment tracks to KMZ without auxiliary duplicate features',()=>verifyP20Gpx('kmz'));

 await mark('P20 EPSG:32650 UTM projected Shapefile to WGS84 coordinate precision',async()=>{
   const source=await makeFixture('geojson');
   const opened=await gdal.open(source);
   const ds=opened.datasets?.[0];assert(ds,'open UTM source');
   const pack=new JSZip();
   try{
     const converted=await gdal.ogr2ogr(ds,['-f','ESRI Shapefile','-t_srs','EPSG:32650','-lco','ENCODING=UTF-8'],'utm50-p20');
     const files=Array.isArray(converted?.all)?converted.all:[converted];
     for(const f of files){
       const name=String(f?.local||f).split('/').pop();
       const b=await gdal.getFileBytes(f);
       if(b?.length)pack.file(name,b);
     }
   }finally{try{gdal.close(ds)}catch{}}
   const names=Object.keys(pack.files);
   assert(names.some(n=>n.endsWith('.prj')),'UTM .prj absent');
   const shpName=names.find(n=>n.endsWith('.shp'));assert(shpName,'UTM .shp absent');
   const raw=await pack.file(shpName).async('uint8array');
   const dv=new DataView(raw.buffer,raw.byteOffset,raw.byteLength);
   const east=dv.getFloat64(112,true),north=dv.getFloat64(120,true);
   assert(east>100000&&east<900000&&north>1000000,'SHP coordinates were not projected into UTM metres');
   const file=new File([await pack.generateAsync({type:'uint8array'})],'utm50.zip');
   const out=await convertGdal(gdal,file,'shp','geojson');
   const point=JSON.parse(new TextDecoder().decode(out.bytes)).features?.[0]?.geometry?.coordinates;
   assert(Array.isArray(point),'WGS84 point missing');
   assert(Math.abs(point[0]-116.4)<.0001&&Math.abs(point[1]-39.9)<.0001,'UTM roundtrip exceeded coordinate tolerance');
   return {sourceProjection:'EPSG:32650',targetProjection:'WGS84',utm:[east,north],result:point};
 });

 await mark('P20 DBF Unicode string integer and decimal roundtrip for two records',async()=>{
   const data={type:'FeatureCollection',features:[
     {type:'Feature',properties:{Code:'A001',Label:'北京公园',Count:12,Score:12.75,Nullable:null},geometry:{type:'Point',coordinates:[116.4,39.9]}},
     {type:'Feature',properties:{Code:'A002',Label:'深圳城区',Count:-3,Score:-2.125,Nullable:null},geometry:{type:'Point',coordinates:[114.1,22.5]}}
   ]};
   const zip=await convertGdal(gdal,new File([JSON.stringify(data)],'dbf-source.geojson'),'geojson','shp');
   const stored=await JSZip.loadAsync(zip.bytes);
   const names=Object.keys(stored.files);
   const cpg=names.find(n=>n.endsWith('.cpg'));
   assert(cpg&&((await stored.file(cpg).async('string')).toUpperCase().includes('UTF-8')),'SHP UTF-8 cpg absent');
   const roundtrip=await convertGdal(gdal,new File([zip.bytes],'p20-fields.zip'),'shp','geojson');
   const parsed=JSON.parse(new TextDecoder().decode(roundtrip.bytes));
   assert(parsed.features?.length===2,'DBF record count changed');
   for(let i=0;i<2;i++){
     const src=data.features[i].properties,got=parsed.features[i].properties;
     assert(src.Code===got.Code&&src.Label===got.Label,'DBF text/Unicode attribute changed for record '+i);
     assert(src.Count===got.Count&&Math.abs(src.Score-got.Score)<.000001,'DBF number attribute changed for record '+i);
   }
   return {records:2,fieldsVerified:['Code','Label','Count','Score'],nullable:'not certified',encoding:'UTF-8'};
 });


 // P21: Run the actual browser GDAL engine on a point-metadata-heavy GPX
 // and prove we do not label time/elevation/extension preservation as certified.
 const gpxP21=gpxP20
  .replace('<wpt lat="39.90" lon="116.40"><name>',
    '<wpt lat="39.90" lon="116.40"><ele>90.1</ele><time>2025-02-01T10:00:00Z</time><name>')
  .replace('<rtept lat="39.8" lon="116.3"/>',
    '<rtept lat="39.8" lon="116.3"><ele>120</ele><time>2025-02-01T10:05:00Z</time></rtept>')
  .replace('<trkpt lat="39.6" lon="116.1"/>',
    '<trkpt lat="39.6" lon="116.1"><ele>135.25</ele><time>2025-02-01T10:10:00Z</time></trkpt>');
 async function testP21GpxMetadata(target) {
   const file=new File([gpxP21],'p21-metadata.gpx');
   const output=await convertGdal(gdal,file,'gpx',target);
   const r=await createGISQualityReport(file,'gpx',output.bytes,target);
   const line=r.checks.find(c=>c.id==='gpx-line-geometry');
   const metadata=r.checks.find(c=>c.id==='gpx-vertex-metadata');
   assert(line?.status==='pass','P21 real GDAL lost/moved GPX segments or vertices '+JSON.stringify(line));
   assert(metadata?.status==='review'&&metadata.detail.includes('elevation')&&metadata.detail.includes('time'),
      'GPX metadata hazard was not presented as a review warning');
   assertNoDetectedCriticalDataLoss(r);
   const reportText=JSON.stringify(r);
   assert(!reportText.includes('2025-02-01T10:10:00Z'),'GPX original timestamps leaked into report');
   return {target,lineStatus:line.status,metadataStatus:metadata.status,summary:line.detail,bytes:output.bytes.length};
 }
 await mark('P21 real GPX point-level time/elevation risk is flagged for KML',()=>testP21GpxMetadata('kml'));
 await mark('P21 real GPX point-level time/elevation risk is flagged for KMZ',()=>testP21GpxMetadata('kmz'));

 await mark('P21 actual DBF null/long UTF-8 string/precision risk is reported without false certification',async()=>{
  const source={type:'FeatureCollection',features:[{
   type:'Feature',properties:{Code:'A01',Title:'中文属性'.repeat(80),
     Nullable:null,Score:1.2345678901234567},
   geometry:{type:'Point',coordinates:[116.4,39.9]}
  }]};
  const file=new File([JSON.stringify(source)],'p21-attributes.geojson');
  const result=await convertGdal(gdal,file,'geojson','shp');
  const quality=await createGISQualityReport(file,'geojson',result.bytes,'shp');
  const risk=quality.checks.find(c=>c.id==='shp-value-limits');
  assert(risk?.status==='review','P21 DBF nullable and width/precision issues not flagged');
  assert(quality.checks.find(c=>c.id==='attribute-fidelity')?.status==='unavailable',
    'P21 claimed arbitrary DBF field value certification');
  const zip=await JSZip.loadAsync(result.bytes);
  const dbfName=Object.keys(zip.files).find(name=>name.endsWith('.dbf'));
  assert(dbfName,'Actual Shapefile DBF missing');
  const bytes=await zip.file(dbfName).async('uint8array');
  const view=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength);
  assert(view.getUint32(4,true)===1,'DBF row count differs from source');
  const headerLength=view.getUint16(8,true),recordLength=view.getUint16(10,true);
  assert(headerLength>=65&&recordLength>1&&headerLength+recordLength<=bytes.length,
    'DBF header or record byte sizes invalid');
  assert(!JSON.stringify(quality).includes('中文属性'),'Original DBF string value leaked into report');
  return {dbfRecords:1,dbfBytes:bytes.length,headerLength,recordLength,dbfValueRisk:risk.status};
 });


 await mark('P22 actual GDAL-produced UTF-8 DBF agrees with safe GeoJSON text and numeric values',async()=>{
  const data={type:'FeatureCollection',features:[
   {type:'Feature',properties:{Code:'A01',Label:'北京公园',Count:12,Score:12.75},
    geometry:{type:'Point',coordinates:[116.4,39.9]}},
   {type:'Feature',properties:{Code:'B02',Label:'深圳公园',Count:-3,Score:-2.125},
    geometry:{type:'Point',coordinates:[114.1,22.5]}}
  ]};
  const file=new File([JSON.stringify(data)],'p22-clean.geojson');
  const converted=await convertGdal(gdal,file,'geojson','shp');
  const report=await createGISQualityReport(file,'geojson',converted.bytes,'shp');
  const value=report.checks.find(c=>c.id==='dbf-attribute-values');
  assert(value?.status==='pass','GDAL DBF attributes did not match: '+JSON.stringify(value));
  assertNoDetectedCriticalDataLoss(report);
  return {dbfStatus:value.status,detail:value.detail};
 });

 await mark('P22 altered GDAL-produced DBF field prevents output download',async()=>{
  const data={type:'FeatureCollection',features:[{type:'Feature',
   properties:{Code:'A01',Label:'北京公园',Count:12,Score:12.75},
   geometry:{type:'Point',coordinates:[116.4,39.9]}}]};
  const file=new File([JSON.stringify(data)],'p22-tamper.geojson');
  const converted=await convertGdal(gdal,file,'geojson','shp');
  const zip=await JSZip.loadAsync(converted.bytes);
  const dbfName=Object.keys(zip.files).find(name=>name.toLowerCase().endsWith('.dbf'));
  assert(dbfName,'Real Shapefile lacks DBF');
  const bytes=await zip.file(dbfName).async('uint8array');
  const view=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength);
  const headerLength=view.getUint16(8,true),recordLength=view.getUint16(10,true);
  let keyOffset=-1,fieldOffset=1;
  for(let off=32;off+32<=headerLength-1;off+=32){
   const nameBytes=bytes.subarray(off,off+11),nul=nameBytes.indexOf(0);
   const name=new TextDecoder().decode(nul>=0?nameBytes.subarray(0,nul):nameBytes).trim();
   if(name==='Code')keyOffset=fieldOffset;
   fieldOffset+=bytes[off+16];
  }
  assert(keyOffset>=0&&headerLength+recordLength<=bytes.length,'Cannot locate Code field in actual GDAL DBF');
  const at=headerLength+keyOffset;
  assert(bytes[at]===65&&bytes[at+1]===48&&bytes[at+2]===49,'Unexpected field location');
  bytes[at]=90; // Z01 instead of A01; valid DBF encoding but definite value change.
  zip.file(dbfName,bytes);
  const modified=new Uint8Array(await zip.generateAsync({type:'uint8array'}));
  const report=await createGISQualityReport(file,'geojson',modified,'shp');
  const value=report.checks.find(c=>c.id==='dbf-attribute-values');
  assert(value?.status==='review','Tampered DBF field was not detected: '+JSON.stringify(value));
  let blocked=false;
  try{assertNoDetectedCriticalDataLoss(report)}catch(error){blocked=error.code==='DATA_LOSS'}
  assert(blocked,'Corrupted DBF was not withheld');
  return {dbfStatus:value.status,withheld:true};
 });

 report.status=report.cases.every(x=>x.status==='PASSED')?'PASSED':'FAILED';
 }catch(e){report.status='FAILED';report.errors.push(String(e instanceof Error?e.stack:JSON.stringify(e)))}
 finally{report.complete=true;document.body.dataset.done='true';render()}
})();
</script></body></html>
